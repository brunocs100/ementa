  "components": {
    "schemas": {
      "AccessToken": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In",
            "description": "Segundos até o token vencer"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_in"
        ],
        "title": "AccessToken"
      },
      "AnswerLegalQuestionInput": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 5,
            "title": "Question"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AnswerLegalQuestionInput"
      },
      "AnswerLegalQuestionOutput": {
        "properties": {
          "answer": {
