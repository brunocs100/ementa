          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "source_id",
          "title",
          "url"
        ],
        "title": "CitationOut"
      },
      "DataClass": {
        "type": "string",
        "enum": [
          "public",
          "restricted",
          "secret"
        ],
        "title": "DataClass",
        "description": "What a tool returns. It decides what may leave to a cloud model or an external MCP client."
      },
      "DoneEvent": {
        "properties": {
          "event": {
            "type": "string",
            "const": "done",
            "title": "Event",
            "default": "done"
          },
          "thread_id": {
            "type": "string",
            "title": "Thread Id",
            "description": "Id da conversa, para continuar com o próximo POST"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "removed": {
            "items": {
