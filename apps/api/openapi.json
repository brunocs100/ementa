{
  "openapi": "3.1.0",
  "info": {
    "title": "Ementa API",
    "description": "Agentes de IA para advocacia. Saídas são rascunho para o advogado conferir.",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/legal-research": {
      "post": {
        "tags": [
          "legal-research"
        ],
        "summary": "Pesquisa jurídica com citações verificadas",
        "description": "Responde uma pergunta jurídica com base no corpus (CDC, LGPD, CPC, súmulas do STJ de Direito do Consumidor e Bancário e súmulas vinculantes do STF). O agente legal_research busca as fontes, escreve a resposta e passa pelo verificador: toda citação mostrada existe no corpus, e o que não foi verificado é removido e listado em `removed`. Não calcula prazo em dias úteis (use calculate_deadline). A saída é rascunho para o advogado conferir.",
        "operationId": "legal_research_v1_legal_research_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerLegalQuestionInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnswerLegalQuestionOutput"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/documents": {
      "post": {
        "tags": [
          "documents"
        ],
        "summary": "Envia um documento do escritório para ingestão em fila",
        "description": "Envia um documento do escritório (texto, Markdown ou PDF com camada de texto, até 2 MiB) para ingestão em fila e responde 202 com o id da tarefa. O documento fica restrito, com quem enviou como dono. Reenviar o mesmo arquivo devolve a mesma tarefa e não grava nada de novo; se a tarefa tinha falhado, ela volta para a fila.",
        "operationId": "upload_document_v1_documents_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_upload_document_v1_documents_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobAccepted"
                }
              }
            }
          },
          "413": {
            "description": "Request Entity Too Large",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "415": {
            "description": "Unsupported Media Type",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/jobs/{job_id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Estado de uma tarefa em fila",
        "operationId": "get_job_v1_jobs__job_id__get",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobState"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "O processo está de pé",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Banco acessível e corpus carregado",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnswerLegalQuestionInput": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 5,
            "title": "Question"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AnswerLegalQuestionInput"
      },
      "AnswerLegalQuestionOutput": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/CitationOut"
            },
            "type": "array",
            "title": "Citations"
          },
          "removed": {
            "items": {
              "$ref": "#/components/schemas/RemovedOut"
            },
            "type": "array",
            "title": "Removed"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources"
          },
          "grounded": {
            "type": "boolean",
            "title": "Grounded"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "notice": {
            "type": "string",
            "title": "Notice",
            "default": "Rascunho para conferência do advogado responsável. Não é aconselhamento jurídico."
          },
          "data_class": {
            "$ref": "#/components/schemas/DataClass",
            "default": "public"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "citations",
          "removed",
          "sources",
          "grounded",
          "prompt",
          "model"
        ],
        "title": "AnswerLegalQuestionOutput"
      },
      "Body_upload_document_v1_documents_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "Arquivo .txt, .md ou .pdf"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_document_v1_documents_post"
      },
      "CitationOut": {
        "properties": {
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "source_id",
          "title",
          "url"
        ],
        "title": "CitationOut"
      },
      "DataClass": {
        "type": "string",
        "enum": [
          "public",
          "restricted",
          "secret"
        ],
        "title": "DataClass",
        "description": "What a tool returns. It decides what may leave to a cloud model or an external MCP client."
      },
      "FieldError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "msg": {
            "type": "string",
            "title": "Msg"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "FieldError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "JobAccepted": {
        "properties": {
          "job_id": {
            "type": "string",
            "title": "Job Id"
          },
          "document_id": {
            "type": "string",
            "title": "Document Id"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "duplicate": {
            "type": "boolean",
            "title": "Duplicate",
            "description": "O mesmo arquivo já tinha sido enviado por este usuário: nada novo foi gravado."
          }
        },
        "type": "object",
        "required": [
          "job_id",
          "document_id",
          "status",
          "duplicate"
        ],
        "title": "JobAccepted"
      },
      "JobState": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "subject": {
            "type": "string",
            "title": "Subject",
            "description": "O que a tarefa processa; em `ingest_document`, o documento."
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "attempts": {
            "type": "integer",
            "title": "Attempts"
          },
          "result": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Finished At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "kind",
          "subject",
          "status",
          "attempts",
          "created_at"
        ],
        "title": "JobState"
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "retrying",
          "succeeded",
          "failed"
        ],
        "title": "JobStatus"
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "default": "about:blank"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "title",
          "status"
        ],
        "title": "Problem"
      },
      "Readiness": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "chunks": {
            "type": "integer",
            "title": "Chunks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "chunks"
        ],
        "title": "Readiness"
      },
      "RemovedOut": {
        "properties": {
          "reference": {
            "type": "string",
            "title": "Reference"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "reference",
          "reason"
        ],
        "title": "RemovedOut"
      }
    }
  }
}
