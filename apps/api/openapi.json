{
  "openapi": "3.1.0",
  "info": {
    "title": "Ementa API",
    "description": "Agentes de IA para advocacia. Saídas são rascunho para o advogado conferir.",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/auth/token": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Troca usuário e senha por um token de acesso",
        "description": "Fluxo OAuth2 de senha, o mesmo do botão Authorize do /docs. Devolve um JWT (HS256) que vale 15 minutos por padrão (`EMENTA_JWT_TTL_MINUTES`); mande-o em `Authorization: Bearer <token>` nas outras rotas. Os usuários fictícios da demo e as senhas estão em docs/SEGURANCA-E-GOVERNANCA.md.",
        "operationId": "issue_token_v1_auth_token_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_issue_token_v1_auth_token_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessToken"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/legal-research": {
      "post": {
        "tags": [
          "legal-research"
        ],
        "summary": "Pesquisa jurídica com citações verificadas",
        "description": "Responde uma pergunta jurídica com base no corpus (CDC, LGPD, CPC, súmulas do STJ de Direito do Consumidor e Bancário e súmulas vinculantes do STF). O agente legal_research busca as fontes, escreve a resposta e passa pelo verificador: toda citação mostrada existe no corpus, e o que não foi verificado é removido e listado em `removed`. Não calcula prazo em dias úteis (use calculate_deadline). A saída é rascunho para o advogado conferir.",
        "operationId": "legal_research_v1_legal_research_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerLegalQuestionInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnswerLegalQuestionOutput"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
    "/v1/data-subjects/{subject_id}/memories": {
      "delete": {
        "tags": [
          "lgpd"
        ],
        "summary": "Apaga as memórias de um titular de dados",
        "description": "Direito do titular (LGPD, art. 18): apaga todas as memórias que citam a pessoa, em todos os namespaces, e devolve quantas saíram. O id é o pseudônimo `ds_...` que etiqueta as memórias (HMAC do CPF, do nome ou do e-mail), nunca o dado em si. Nada pessoal fica registrado. Só DPO e sócia.",
        "operationId": "forget_data_subject_v1_data_subjects__subject_id__memories_delete",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "subject_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^ds_[0-9a-f]{32}$",
              "description": "Pseudônimo do titular, `ds_...`",
              "title": "Subject Id"
            },
            "description": "Pseudônimo do titular, `ds_...`"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Forgotten"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/v1/audit/events": {
      "get": {
        "tags": [
          "audit"
        ],
        "summary": "Trilha de auditoria, do evento mais novo ao mais antigo",
        "description": "Eventos de `audit.events`, do mais novo ao mais antigo: quem chamou, que rota, status e duração, com o hash encadeado de cada um. Nunca o corpo do pedido. Para a próxima página, mande o `next_cursor` recebido em `cursor`. Só sócia, DPO e TI; a conferência da cadeia é `uv run ementa audit verify`.",
        "operationId": "audit_events_v1_audit_events_get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,17}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "O `next_cursor` da página anterior",
              "title": "Cursor"
            },
            "description": "O `next_cursor` da página anterior"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "Eventos por página",
              "default": 50,
              "title": "Limit"
            },
            "description": "Eventos por página"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPage"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "O processo está de pé",
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Banco acessível e corpus carregado",
        "operationId": "readyz_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AccessToken": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "title": "Token Type",
            "default": "bearer"
          },
          "expires_in": {
            "type": "integer",
            "title": "Expires In",
            "description": "Segundos até o token vencer"
          }
        },
        "type": "object",
        "required": [
          "access_token",
          "expires_in"
        ],
        "title": "AccessToken"
      },
      "AnswerLegalQuestionInput": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 5,
            "title": "Question"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AnswerLegalQuestionInput"
      },
      "AnswerLegalQuestionOutput": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/CitationOut"
            },
            "type": "array",
            "title": "Citations"
          },
          "removed": {
            "items": {
              "$ref": "#/components/schemas/RemovedOut"
            },
            "type": "array",
            "title": "Removed"
          },
          "sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sources"
          },
          "grounded": {
            "type": "boolean",
            "title": "Grounded"
          },
          "prompt": {
            "type": "string",
            "title": "Prompt"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "notice": {
            "type": "string",
            "title": "Notice",
            "default": "Rascunho para conferência do advogado responsável. Não é aconselhamento jurídico."
          },
          "data_class": {
            "$ref": "#/components/schemas/DataClass",
            "default": "public"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "citations",
          "removed",
          "sources",
          "grounded",
          "prompt",
          "model"
        ],
        "title": "AnswerLegalQuestionOutput"
      },
      "AuditEventOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "actor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor"
          },
          "action": {
            "type": "string",
            "title": "Action"
          },
          "resource": {
            "type": "string",
            "title": "Resource"
          },
          "data_class": {
            "type": "string",
            "title": "Data Class"
          },
          "outcome": {
            "type": "string",
            "title": "Outcome"
          },
          "details": {
            "additionalProperties": true,
            "type": "object",
            "title": "Details"
          },
          "prev_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prev Hash"
          },
          "hash": {
            "type": "string",
            "title": "Hash"
          }
        },
        "type": "object",
        "required": [
          "id",
          "occurred_at",
          "actor",
          "action",
          "resource",
          "data_class",
          "outcome",
          "details",
          "prev_hash",
          "hash"
        ],
        "title": "AuditEventOut"
      },
      "AuditPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/AuditEventOut"
            },
            "type": "array",
            "title": "Items"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Cursor"
          }
        },
        "type": "object",
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "AuditPage"
      },
      "Body_issue_token_v1_auth_token_post": {
        "properties": {
          "grant_type": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^password$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grant Type"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "password": {
            "type": "string",
            "format": "password",
            "title": "Password"
          },
          "scope": {
            "type": "string",
            "title": "Scope",
            "default": ""
          },
          "client_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Client Id"
          },
          "client_secret": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "format": "password",
            "title": "Client Secret"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Body_issue_token_v1_auth_token_post"
      },
      "CitationOut": {
        "properties": {
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "url": {
            "type": "string",
            "title": "Url"
          }
        },
        "type": "object",
        "required": [
          "source_id",
          "title",
          "url"
        ],
        "title": "CitationOut"
      },
      "DataClass": {
        "type": "string",
        "enum": [
          "public",
          "restricted",
          "secret"
        ],
        "title": "DataClass",
        "description": "What a tool returns. It decides what may leave to a cloud model or an external MCP client."
      },
      "FieldError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Loc"
          },
          "msg": {
            "type": "string",
            "title": "Msg"
          },
          "type": {
            "type": "string",
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "FieldError"
      },
      "Forgotten": {
        "properties": {
          "removed": {
            "type": "integer",
            "title": "Removed",
            "description": "Memórias apagadas; 0 se o titular já não tinha nenhuma."
          }
        },
        "type": "object",
        "required": [
          "removed"
        ],
        "title": "Forgotten"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "Problem": {
        "properties": {
          "type": {
            "type": "string",
            "title": "Type",
            "default": "about:blank"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "integer",
            "title": "Status"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/FieldError"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          }
        },
        "type": "object",
        "required": [
          "title",
          "status"
        ],
        "title": "Problem"
      },
      "Readiness": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "chunks": {
            "type": "integer",
            "title": "Chunks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "chunks"
        ],
        "title": "Readiness"
      },
      "RemovedOut": {
        "properties": {
          "reference": {
            "type": "string",
            "title": "Reference"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "reference",
          "reason"
        ],
        "title": "RemovedOut"
      }
    },
    "securitySchemes": {
      "OAuth2PasswordBearer": {
        "type": "oauth2",
        "flows": {
          "password": {
            "scopes": {},
            "tokenUrl": "/v1/auth/token"
          }
        }
      }
    }
  }
}
