          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "notice": {
            "type": "string",
            "title": "Notice",
            "default": "Rascunho para conferência do advogado responsável. Não é aconselhamento jurídico."
          },
          "data_class": {
            "$ref": "#/components/schemas/DataClass",
            "default": "public"
          }
        },
        "type": "object",
        "required": [
          "answer",
          "citations",
          "removed",
          "sources",
          "grounded",
          "prompt",
          "model"
        ],
        "title": "AnswerLegalQuestionOutput"
      },
      "AuditEventOut": {
        "properties": {
