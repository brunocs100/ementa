{
  "openapi": "3.1.0",
  "info": {
    "title": "Ementa API",
    "description": "Agentes de IA para advocacia. Saídas são rascunho para o advogado conferir.",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/auth/token": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Troca usuário e senha por um token de acesso",
        "description": "Fluxo OAuth2 de senha, o mesmo do botão Authorize do /docs. Devolve um JWT (HS256) que vale 15 minutos por padrão (`EMENTA_JWT_TTL_MINUTES`); mande-o em `Authorization: Bearer <token>` nas outras rotas. Os usuários fictícios da demo e as senhas estão em docs/SEGURANCA-E-GOVERNANCA.md.",
        "operationId": "issue_token_v1_auth_token_post",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": {
                "$ref": "#/components/schemas/Body_issue_token_v1_auth_token_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessToken"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/chat": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Conversa com o assistente, em SSE",
        "description": "Conversa com o assistente da Ementa, que encaminha o pedido ao `legal_research` ou ao `calculate_deadline`. A resposta é um fluxo SSE (`text/event-stream`): cada evento traz um JSON em `data`, com o tipo no campo `event`. `step`: um passo começou ou terminou (o modelo, `supervisor`, ou uma ferramenta). `token`: um pedaço da resposta, palavra inteira, com os dados pessoais de volta. `citation`: uma fonte verificada pelo `legal_research`. `done`: o último evento, com o `thread_id` e a resposta final depois da conferência das citações, que prevalece sobre os tokens. `error`: um problema RFC 9457, quando o erro acontece com o fluxo já aberto. Sem `thread_id` começa uma conversa nova; com ele, continua uma conversa sua.",
        "operationId": "chat_v1_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/event-stream": {
                "itemSchema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "string",
                      "contentMediaType": "application/json",
                      "contentSchema": {
                        "oneOf": [
                          {
                            "$ref": "#/components/schemas/StepEvent"
                          },
                          {
                            "$ref": "#/components/schemas/TokenEvent"
                          },
                          {
                            "$ref": "#/components/schemas/CitationEvent"
                          },
                          {
                            "$ref": "#/components/schemas/DoneEvent"
                          },
                          {
                            "$ref": "#/components/schemas/ErrorEvent"
                          }
                        ],
                        "discriminator": {
                          "propertyName": "event",
                          "mapping": {
                            "step": "#/components/schemas/StepEvent",
                            "token": "#/components/schemas/TokenEvent",
                            "citation": "#/components/schemas/CitationEvent",
                            "done": "#/components/schemas/DoneEvent",
                            "error": "#/components/schemas/ErrorEvent"
                          }
                        },
                        "title": "Streamitem Chat V1 Chat Post"
                      }
                    },
                    "event": {
                      "type": "string"
                    },
                    "id": {
                      "type": "string"
                    },
                    "retry": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
    "/v1/threads/{thread_id}": {
      "get": {
        "tags": [
          "chat"
        ],
        "summary": "Histórico de uma conversa",
        "description": "As mensagens de uma conversa sua, com os dados pessoais como foram digitados na primeira vez. Conversa de outra pessoa responde 404, como uma que não existe.",
        "operationId": "thread_v1_threads__thread_id__get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "thread_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Thread Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ThreadHistory"
                }
              }
            }
          },
          "404": {
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/v1/legal-research": {
      "post": {
        "tags": [
          "legal-research"
        ],
        "summary": "Pesquisa jurídica com citações verificadas",
        "description": "Responde uma pergunta jurídica com base no corpus (CDC, LGPD, CPC, súmulas do STJ de Direito do Consumidor e Bancário e súmulas vinculantes do STF). O agente legal_research busca as fontes, escreve a resposta e passa pelo verificador: toda citação mostrada existe no corpus, e o que não foi verificado é removido e listado em `removed`. Não calcula prazo em dias úteis (use calculate_deadline). A saída é rascunho para o advogado conferir.",
        "operationId": "legal_research_v1_legal_research_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnswerLegalQuestionInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnswerLegalQuestionOutput"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ]
      }
    },
    "/v1/data-subjects/{subject_id}/memories": {
      "delete": {
        "tags": [
          "lgpd"
        ],
        "summary": "Apaga as memórias de um titular de dados",
        "description": "Direito do titular (LGPD, art. 18): apaga todas as memórias que citam a pessoa, em todos os namespaces, e devolve quantas saíram. O id é o pseudônimo `ds_...` que etiqueta as memórias (HMAC do CPF, do nome ou do e-mail), nunca o dado em si. Nada pessoal fica registrado. Só DPO e sócia.",
        "operationId": "forget_data_subject_v1_data_subjects__subject_id__memories_delete",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "subject_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^ds_[0-9a-f]{32}$",
              "description": "Pseudônimo do titular, `ds_...`",
              "title": "Subject Id"
            },
            "description": "Pseudônimo do titular, `ds_...`"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Forgotten"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "500": {
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/v1/audit/events": {
      "get": {
        "tags": [
          "audit"
        ],
        "summary": "Trilha de auditoria, do evento mais novo ao mais antigo",
        "description": "Eventos de `audit.events`, do mais novo ao mais antigo: quem chamou, que rota, status e duração, com o hash encadeado de cada um. Nunca o corpo do pedido. Para a próxima página, mande o `next_cursor` recebido em `cursor`. Só sócia, DPO e TI; a conferência da cadeia é `uv run ementa audit verify`.",
        "operationId": "audit_events_v1_audit_events_get",
        "security": [
          {
            "OAuth2PasswordBearer": []
          }
        ],
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,17}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "O `next_cursor` da página anterior",
              "title": "Cursor"
            },
            "description": "O `next_cursor` da página anterior"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "Eventos por página",
              "default": 50,
              "title": "Limit"
            },
            "description": "Eventos por página"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPage"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/problem+json": {},
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        }
      }
    },
