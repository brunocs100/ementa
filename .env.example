# Copy to .env and fill in. .env is not versioned.

EMENTA_ENV=dev
EMENTA_LOG_LEVEL=INFO
EMENTA_LOG_JSON=true

EMENTA_DATABASE_URL=postgresql://ementa:ementa@localhost:5432/ementa

EMENTA_OTEL_ENABLED=true
EMENTA_OTEL_ENDPOINT=http://localhost:4318

# Key of the "ementa" project in the OpenAI dashboard, with a spend limit. Needed from F1.
OPENAI_API_KEY=
