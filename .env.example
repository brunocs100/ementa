# Copy to .env and fill in. .env is not versioned.

EMENTA_ENV=dev
EMENTA_LOG_LEVEL=INFO
EMENTA_LOG_JSON=true

EMENTA_DATABASE_URL=postgresql://ementa:ementa@localhost:5432/ementa

EMENTA_OTEL_ENABLED=true
EMENTA_OTEL_ENDPOINT=http://localhost:4318

# Skill scripts allowed to run, as a JSON list of "<skill>/<script>". Empty: none runs.
EMENTA_SKILL_SCRIPTS_ALLOWED=[]
EMENTA_SKILL_SCRIPT_TIMEOUT_S=10

# Long-term memory. The key of the HMAC behind the data subject ids that tag memories (LGPD
# forgetting): required in prod, a development key otherwise. Changing it orphans stored ids.
EMENTA_DATA_SUBJECT_KEY=
EMENTA_MEMORY_DEDUPE_SIMILARITY=0.97
EMENTA_MEMORY_MIN_CONFIDENCE=0.7
# Signs the API tokens (HS256), at least 32 characters. Required with EMENTA_ENV=prod; in dev
# and ci each process draws a random one. To make one:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
# EMENTA_JWT_SECRET=
EMENTA_JWT_TTL_MINUTES=15

# Key of the "ementa" project in the OpenAI dashboard, with a spend limit. Needed from F1.
OPENAI_API_KEY=
